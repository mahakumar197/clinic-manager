# Copy to .env.stage (or .env.development) and point at your local APIs.
# Vite is started with: npm run dev  (uses --mode stage)

VITE_ENV=stage
VITE_APP_NAME=Pall Mall
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_LOGGING=true

VITE_API_BASE_URL=http://localhost:3001
VITE_MAIN_API_BASE_URL=http://localhost:3002
VITE_NOTIFICATION_API_BASE_URL=http://localhost:3004
VITE_REPORTS_API_BASE_URL=http://localhost:3005
