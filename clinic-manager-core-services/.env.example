# ==================== Database Configuration ====================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=password

# Database names for each service
DB_NAME_OPERATIONS=operations_db
DB_NAME_PATIENT=patient_db
DB_NAME_CONTENT=content_db
DB_NAME_NOTIFICATION=notification_db
DB_NAME_INTEGRATION=integration_db

# ==================== JWT Configuration ====================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=1h

# ==================== CORS Configuration ====================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ==================== Google OAuth ====================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/redirect

# ==================== Facebook OAuth ====================
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:3001/api/v1/auth/facebook/redirect

# ==================== Apple Sign In ====================
APPLE_CLIENT_ID=your.apple.service.id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=./certs/apple-private-key.p8
APPLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/apple/redirect

# ==================== Redis Configuration ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== Kafka Configuration ====================
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=pallmall-system
KAFKA_GROUP_ID=pallmall-group

# ==================== Email Service (Sendgrid) ====================
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@pallmall.com
SENDGRID_FROM_NAME=pallmall Management System

# ==================== SMS Service (Twilio) ====================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ==================== Push Notifications ====================
# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# APNs (Apple Push Notification Service)
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apns-team-id
APNS_PRIVATE_KEY_PATH=./certs/apns-private-key.p8

# ==================== Zoho CRM Integration ====================
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token
ZOHO_API_DOMAIN=https://www.zohoapis.com

# ==================== Application Configuration ====================
NODE_ENV=development

# Service Ports
PORT_OPERATIONS=3001
PORT_CONTENT=3003
PORT_NOTIFICATION=3004
PORT_PATIENT=3002
PORT_INTEGRATION=3005

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# OTP Configuration
OTP_EXPIRY_MINUTES=10
MAX_OTP_ATTEMPTS=3
MAX_OTP_PER_HOUR=3

# Account Lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30
